# ResourceBook environment variables
# Copy this file to `.env.local` (never committed) and fill in the values from
# Supabase -> Project Settings -> API Keys.

# Project URL, e.g. https://abcdefghijkl.supabase.co
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co

# Publishable key (sb_publishable_...). Safe to expose: read-only for visitors.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# Secret key (sb_secret_...). Full write access - used ONLY by scripts in /scripts.
# Never prefix with NEXT_PUBLIC_ and never share it.
SUPABASE_SECRET_KEY=sb_secret_...
